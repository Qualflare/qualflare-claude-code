{
  "name": "qualflare-ai",
  "version": "0.1.0",
  "description": "Setup wizard for Qualflare AI coding-agent integration",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "qualflare-ai": "./dist/cli.mjs",
    "qualflare-setup": "./dist/cli.mjs"
  },
  "main": "./dist/cli.mjs",
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "cac": "^6.7.14",
    "fast-xml-parser": "^4.4.0",
    "picocolors": "^1.1.0",
    "smol-toml": "^1.3.1",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.32.1"
}
